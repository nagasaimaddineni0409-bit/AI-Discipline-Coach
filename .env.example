EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Required for "Continue with Google". From Firebase Console → Authentication →
# Sign-in method → Google → Web SDK configuration → Web client ID
# (also listed in Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs → Web client)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Optional native client IDs (Expo Go often works with Web client ID alone)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_APP_ENV=development
