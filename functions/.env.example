# Copy to functions/.env (gitignored) before deploy, or set the same keys
# as Cloud Functions environment variables / secrets.
#
# Option A — Resend (recommended): https://resend.com
# Without a verified domain, use beth.t@example.com (delivers only to your Resend login email).
# After DNS is verified, use reviews@yourdomain.com
RESEND_API_KEY=
MAIL_FROM=Discipline AI Clinical Review <beth.t@example.com>

# Option B — SMTP (Gmail app password, SendGrid SMTP, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
